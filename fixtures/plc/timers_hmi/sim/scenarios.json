{"scenarios": [
 {"id": "S1", "name": "Normal fill runs for the 30 s preset", "category": "normal", "scan_ms": 10, "duration_ms": 31000,
  "initial": {"Stop_PB": 1, "Tank_Full": 0},
  "events": [{"at_ms": 100, "set": {"Start_PB": 1}}, {"at_ms": 300, "set": {"Start_PB": 0}}],
  "observe": ["Fill_Valve", "Fill_Active", "Fill_Timer.DN", "Fill_Timer.ACC", "Batch_Count.ACC"]},
 {"id": "S2", "name": "High level ends the fill early", "category": "normal", "scan_ms": 10, "duration_ms": 8000,
  "initial": {"Stop_PB": 1, "Tank_Full": 0},
  "events": [{"at_ms": 100, "set": {"Start_PB": 1}}, {"at_ms": 300, "set": {"Start_PB": 0}}, {"at_ms": 5000, "set": {"Tank_Full": 1}}],
  "observe": ["Fill_Valve", "Fill_Active", "Batch_Count.ACC"]},
 {"id": "S3", "name": "Stop pressed mid-fill", "category": "reset", "scan_ms": 10, "duration_ms": 8000,
  "initial": {"Stop_PB": 1, "Tank_Full": 0},
  "events": [{"at_ms": 100, "set": {"Start_PB": 1}}, {"at_ms": 300, "set": {"Start_PB": 0}},
             {"at_ms": 5000, "set": {"Stop_PB": 0}}, {"at_ms": 5200, "set": {"Stop_PB": 1}}],
  "observe": ["Fill_Valve", "Fill_Active", "Fill_Timer.ACC", "Batch_Count.ACC"]},
 {"id": "S4", "name": "Power cycle mid-fill after one completed batch", "category": "power_cycle", "scan_ms": 10, "duration_ms": 12000,
  "initial": {"Stop_PB": 1, "Tank_Full": 0},
  "events": [{"at_ms": 100, "set": {"Start_PB": 1}}, {"at_ms": 300, "set": {"Start_PB": 0}},
             {"at_ms": 2000, "set": {"Tank_Full": 1}}, {"at_ms": 2500, "set": {"Tank_Full": 0}},
             {"at_ms": 3000, "set": {"Start_PB": 1}}, {"at_ms": 3200, "set": {"Start_PB": 0}},
             {"at_ms": 8000, "power_cycle": true}],
  "observe": ["Fill_Valve", "Fill_Active", "Batch_Count.ACC"]},
 {"id": "S5", "name": "HMI resets the batch counter", "category": "reset", "scan_ms": 10, "duration_ms": 6000,
  "initial": {"Stop_PB": 1, "Tank_Full": 0},
  "events": [{"at_ms": 100, "set": {"Start_PB": 1}}, {"at_ms": 300, "set": {"Start_PB": 0}},
             {"at_ms": 1000, "set": {"Tank_Full": 1}}, {"at_ms": 1500, "set": {"Tank_Full": 0}},
             {"at_ms": 2000, "set": {"Start_PB": 1}}, {"at_ms": 2200, "set": {"Start_PB": 0}},
             {"at_ms": 3000, "set": {"Tank_Full": 1}}, {"at_ms": 3500, "set": {"Tank_Full": 0}},
             {"at_ms": 4500, "set": {"HMI_Reset_Count": 1}}, {"at_ms": 4700, "set": {"HMI_Reset_Count": 0}}],
  "observe": ["Batch_Count.ACC", "Fill_Active"]}
]}
