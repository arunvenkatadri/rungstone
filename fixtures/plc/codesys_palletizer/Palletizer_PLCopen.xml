      <pou name="FB_Station" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="bEnable"><type><BOOL /></type></variable>
          </inputVars>
          <outputVars>
            <variable name="bReady"><type><BOOL /></type></variable>
            <variable name="nErrorId"><type><UDINT /></type></variable>
          </outputVars>
          <localVars>
            <variable name="bFaulted"><type><BOOL /></type></variable>
          </localVars>
          <addData>
            <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
              <InterfaceAsPlainText><xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK ABSTRACT FB_Station IMPLEMENTS I_Station
VAR_INPUT
	bEnable : BOOL;
END_VAR
VAR_OUTPUT
	bReady : BOOL;
	nErrorId : UDINT;
END_VAR
VAR
	bFaulted : BOOL;
END_VAR
</xhtml></InterfaceAsPlainText>
            </data>
            <data name="http://www.3s-software.com/plcopenxml/pouinheritance" handleUnknown="implementation">
              <Inheritance><Implements>I_Station</Implements></Inheritance>
            </data>
          </addData>
        </interface>
        <body><ST><xhtml xmlns="http://www.w3.org/1999/xhtml">bReady := bEnable AND NOT bFaulted;</xhtml></ST></body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="Reset" ObjectId="7a1c0f2e-1b4d-4c55-9a77-0f1e2d3c4b5a">
              <interface><returnType><BOOL /></returnType></interface>
              <body><ST><xhtml xmlns="http://www.w3.org/1999/xhtml">THIS^.bFaulted := FALSE;
THIS^.nErrorId := 0;
Reset := TRUE;</xhtml></ST></body>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/property" handleUnknown="implementation">
