{
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "^(rungstone:)?export$",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/export_gate.py\"", "timeout": 15 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/network_guard.py\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/network_guard.py\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/network_guard.py\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/safety_scan.py\"", "timeout": 10 }
        ]
      }
    ]
  }
}
