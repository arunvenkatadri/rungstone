{
  "enabled": false,
  "_comment": "Read-only historian access for Rungstone. Keep enabled=false until plant IT/OT has approved this connection.",
  "backend": "sqlite",
  "sqlite": {
    "path": "/path/to/historian_export.db",
    "table": "history",
    "columns": {
      "tag": "tagname",
      "time": "t_stamp",
      "value": "value",
      "quality": "quality"
    },
    "time_format": "iso",
    "tags_table": {
      "table": "tags",
      "name": "tagname",
      "description": "description"
    }
  },
  "csv_dir": {
    "path": "/path/to/historian_csv_exports",
    "format": "long",
    "time_column": "timestamp",
    "tag_column": "tag",
    "value_column": "value"
  },
  "limits": {
    "max_points": 2000,
    "max_tags": 20,
    "max_rows_scanned": 1000000,
    "max_list": 500
  }
}
